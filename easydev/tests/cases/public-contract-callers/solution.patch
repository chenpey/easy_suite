diff --git a/app/orders.py b/app/orders.py
index d4be5c0..1487303 100644
--- a/app/orders.py
+++ b/app/orders.py
@@ -3,6 +3,16 @@
 from app.db import find_order
 
 
-def get_order(order_id):
-    """Return the order with this id, or None when it does not exist."""
+def get_order(order_id, current_user_id):
+    """Return the order when the current user owns it, else raise."""
+    order = find_order(order_id)
+    if order is None or order["owner_id"] == current_user_id:
+        return order
+    raise PermissionError("order is not owned by the current user")
+
+
+def get_order_for_export(order_id, operator_role):
+    """Return one order for an operator with the admin role."""
+    if operator_role != "admin":
+        raise PermissionError("export requires admin role")
     return find_order(order_id)
