#!/usr/bin/env node

/**
 * EasyJev - Single-file MCP server & CLI for Cloudflare Workers AI Jev model.
 * Zero external dependencies. Pure Node.js standard library.
 */

const fs = require("node:fs");
const path = require("node:path");
const os = require("node:os");
const readline = require("node:readline");
const { Writable } = require("node:stream");
const { execSync } = require("node:child_process");

const SCRIPT_PATH = fs.realpathSync(process.argv[1]);
const SCRIPT_DIR = path.dirname(SCRIPT_PATH);

// Canonical installation location in user's home directory
const HOME_DIR = os.homedir();
const HIDDEN_INSTALL_DIR = path.join(HOME_DIR, ".easyjev");
const HIDDEN_BIN_PATH = path.join(HIDDEN_INSTALL_DIR, "easyjev");
const HIDDEN_CONFIG_PATH = path.join(HIDDEN_INSTALL_DIR, "config.json");
const LOCAL_CONFIG_PATH = path.join(SCRIPT_DIR, "config.json");

const CLOUDFLARE_API_BASE = "https://api.cloudflare.com/client/v4";
const JEV_MODEL = "typesafe/jev";

let inMemoryAccountId = null;

// ==========================================
// Cloudflare Workers AI Client
// ==========================================

async function callCloudflare(endpoint, token, options = {}) {
  const url = endpoint.startsWith("http") ? endpoint : `${CLOUDFLARE_API_BASE}${endpoint}`;
  let response;
  let text;
  try {
    response = await fetch(url, {
      ...options,
      headers: {
        Authorization: `Bearer ${token}`,
        "Content-Type": "application/json",
        ...(options.headers || {}),
      },
      signal: AbortSignal.timeout(30000),
    });
    text = await response.text();
  } catch (err) {
    throw new Error(`Network request to Cloudflare failed: ${err.message}`);
  }

  let data;
  try {
    data = JSON.parse(text);
  } catch {
    throw new Error(`Cloudflare API returned non-JSON (HTTP ${response.status}): ${text}`);
  }

  if (!response.ok || (data.success !== true && data.result === undefined)) {
    const msg = data.errors?.map((e) => e.message).join("; ") || text;
    throw new Error(`Cloudflare API error (HTTP ${response.status}): ${msg}`);
  }

  return data;
}

async function verifyToken(token) {
  const res = await callCloudflare("/user/tokens/verify", token);
  return res.result?.status === "active";
}

async function resolveAccountId(token) {
  if (inMemoryAccountId) return inMemoryAccountId;

  const res = await callCloudflare("/accounts", token);
  const accounts = res.result || [];
  if (!accounts.length) {
    throw new Error("No accessible Cloudflare accounts found for this API Token.");
  }
  inMemoryAccountId = accounts[0].id;
  return inMemoryAccountId;
}

async function runJev(token, { state, questions }) {
  const accountId = await resolveAccountId(token);

  // Strategy 1: Cloudflare Universal AI endpoint (/ai/run) with { model, input }
  try {
    const res = await callCloudflare(`/accounts/${accountId}/ai/run`, token, {
      method: "POST",
      body: JSON.stringify({
        model: JEV_MODEL,
        input: { state, questions },
      }),
    });
    return res.result;
  } catch (err1) {
    // Strategy 2: Direct model path endpoint (/ai/run/typesafe/jev) with { state, questions }
    try {
      const res = await callCloudflare(`/accounts/${accountId}/ai/run/${JEV_MODEL}`, token, {
        method: "POST",
        body: JSON.stringify({ state, questions }),
      });
      return res.result;
    } catch (err2) {
      // Strategy 3: Legacy or alias with @cf/ prefix (/ai/run/@cf/typesafe/jev)
      try {
        const res = await callCloudflare(`/accounts/${accountId}/ai/run/@cf/${JEV_MODEL}`, token, {
          method: "POST",
          body: JSON.stringify({ state, questions }),
        });
        return res.result;
      } catch (err3) {
        throw new Error(
          `Jev inference failed on Cloudflare:\n  1. /ai/run: ${err1.message}\n  2. /ai/run/${JEV_MODEL}: ${err2.message}\n  3. /ai/run/@cf/${JEV_MODEL}: ${err3.message}`
        );
      }
    }
  }
}

// ==========================================
// Config Management (Mode 0600)
// ==========================================

function loadConfig() {
  // Check local directory first (e.g. if running inside easy_suite/easyjev)
  if (fs.existsSync(LOCAL_CONFIG_PATH)) {
    try {
      return JSON.parse(fs.readFileSync(LOCAL_CONFIG_PATH, "utf-8"));
    } catch (err) {
      throw new Error(`Failed to parse ${LOCAL_CONFIG_PATH}: ${err.message}`);
    }
  }
  // Check hidden home directory (~/.easyjev/config.json)
  if (fs.existsSync(HIDDEN_CONFIG_PATH)) {
    try {
      return JSON.parse(fs.readFileSync(HIDDEN_CONFIG_PATH, "utf-8"));
    } catch (err) {
      throw new Error(`Failed to parse ${HIDDEN_CONFIG_PATH}: ${err.message}`);
    }
  }
  return null;
}

function saveConfig(token, targetPath = LOCAL_CONFIG_PATH) {
  const data = JSON.stringify({ api_token: token.trim() }, null, 2);
  fs.writeFileSync(targetPath, data, { mode: 0o600 });
  // Ensure mode 0600 on existing files as well
  try {
    fs.chmodSync(targetPath, 0o600);
  } catch {}
}

// ==========================================
// Interactive Terminal Utilities
// ==========================================

function ask(promptText, secret = false) {
  return new Promise((resolve) => {
    const output = new Writable({
      write(chunk, encoding, callback) {
        if (!secret) process.stdout.write(chunk);
        callback();
      },
    });
    const rl = readline.createInterface({
      input: process.stdin,
      output: secret ? output : process.stdout,
      terminal: true,
    });

    if (secret) process.stdout.write(promptText);
    rl.question(secret ? "" : promptText, (answer) => {
      rl.close();
      if (secret) process.stdout.write("\n");
      resolve(answer.trim());
    });
  });
}

// ==========================================
// CLI & Setup Mode
// ==========================================

async function runSetup() {
  console.log("\n=========================================");
  console.log("       EasyJev 交互式极简配置引导         ");
  console.log("=========================================\n");
  console.log("只需输入 1 个 Cloudflare API Token (具有 Workers AI: Read 与 Account Settings: Read 权限)。");
  console.log("输入内容在终端中将静默隐藏，不在命令行历史中留痕。\n");

  const token = await ask("Cloudflare API Token (hidden): ", true);
  if (!token) {
    console.error("❌ Token 不能为空。");
    process.exit(1);
  }

  process.stdout.write("⏳ 正在验证 Token 有效性...");
  try {
    const active = await verifyToken(token);
    if (!active) {
      console.log("\n❌ Token 无效或未处于激活状态。");
      process.exit(1);
    }
    console.log(" [有效]");
  } catch (err) {
    console.log(`\n❌ 验证失败: ${err.message}`);
    process.exit(1);
  }

  process.stdout.write("⏳ 正在自动探测关联 Account ID...");
  let accountId;
  try {
    accountId = await resolveAccountId(token);
    console.log(` [已发现: ${accountId}]`);
  } catch (err) {
    console.log(`\n❌ 获取账号失败: ${err.message}`);
    console.log("请确保 Token 包含 'Account -> Account Settings -> Read' 权限。");
    process.exit(1);
  }

  process.stdout.write("⏳ 正在测试 Cloudflare Workers AI Jev 模型推理...");
  try {
    const testResult = await runJev(token, {
      state: "System operational check.",
      questions: {
        is_operational: {
          type: "noul",
          instructions: "Is this system check operational?",
          criteria: { true: "Operational", false: "Failure" },
        },
      },
    });
    console.log(" [成功]");
  } catch (err) {
    console.log(`\n❌ Jev 推理测试失败: ${err.message}`);
    process.exit(1);
  }

  // 1. Ensure ~/.easyjev directory exists
  fs.mkdirSync(HIDDEN_INSTALL_DIR, { recursive: true });

  // 2. Automatically copy and install to ~/.easyjev/easyjev if not already there
  let activeBinPath = SCRIPT_PATH;
  if (SCRIPT_PATH !== HIDDEN_BIN_PATH) {
    try {
      fs.copyFileSync(SCRIPT_PATH, HIDDEN_BIN_PATH);
      fs.chmodSync(HIDDEN_BIN_PATH, 0o755);
      activeBinPath = HIDDEN_BIN_PATH;
      console.log(`\n📦 已自动安装至隐藏目录: ${HIDDEN_BIN_PATH}`);
    } catch (err) {
      console.error(`⚠️ 自动安装至 ~/.easyjev 失败: ${err.message}`);
    }
  }

  // 3. Save config to ~/.easyjev/config.json
  saveConfig(token, HIDDEN_CONFIG_PATH);
  console.log(`✅ 配置已保存至: ${HIDDEN_CONFIG_PATH}`);
  console.log("🔒 文件权限已锁定为 0600 (仅当前用户可读写)。");

  // If run from a repo, also save locally for convenience
  if (SCRIPT_DIR !== HIDDEN_INSTALL_DIR) {
    try {
      saveConfig(token, LOCAL_CONFIG_PATH);
    } catch {}
  }

  // 4. Register activeBinPath in Codex
  let codexFound = false;
  try {
    execSync("command -v codex", { stdio: "ignore" });
    codexFound = true;
  } catch {}

  if (codexFound) {
    console.log("\n检测到本机已安装 Codex CLI，正在自动注册 MCP Server...");
    try {
      execSync(`codex mcp add easyjev -- "${activeBinPath}"`, { stdio: "inherit" });
      console.log("🎉 已成功自动注册到 Codex！");
    } catch (err) {
      console.log("⚠️ 自动注册失败，可手动执行以下命令接入：");
      console.log(`   codex mcp add easyjev -- "${activeBinPath}"`);
    }
  } else {
    console.log("\n💡 接入 Codex 方法：");
    console.log(`   codex mcp add easyjev -- "${activeBinPath}"`);
  }

  console.log("\n💡 接入 Antigravity 方法：");
  console.log("   在 mcp_config.json 的 mcpServers 中添加：");
  console.log(`   "easyjev": { "command": "${activeBinPath}" }`);

  if (SCRIPT_PATH !== HIDDEN_BIN_PATH) {
    console.log(`\n✨ 提示：当前下载的安装文件现在可以安全删除了，Codex 将永久调用隐藏目录下的服务。`);
  }
}

