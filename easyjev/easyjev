    console.error(`❌ 测试失败: ${err.message}`);
    process.exit(1);
  }
}

// ==========================================
// MCP Server (JSON-RPC 2.0 over stdio)
// ==========================================

const MCP_TOOLS = [
  {
    name: "jev_eval",
    description:
      "Fast structured decision making using Cloudflare Workers AI Jev model. Evaluates state against typed questions (noul/boolean, choice, score) with calibrated confidence.",
    inputSchema: {
      type: "object",
      properties: {
        state: {
          type: "string",
          description: "The input text, code snippet, or context to evaluate.",
        },
        questions: {
          type: "object",
          description:
            "Map of question objects. Each question defines type ('noul', 'choice', 'score'), instructions, and criteria.",
        },
      },
      required: ["state", "questions"],
    },
  },
  {
    name: "jev_label",
    description:
      "Classify or label text or records into categories using Jev decision model.",
    inputSchema: {
      type: "object",
      properties: {
        text: {
          type: "string",
          description: "The text, ticket, or record to classify.",
        },
        labels: {
          type: "array",
          items: { type: "string" },
          description: "List of possible labels/categories to choose from.",
        },
        instructions: {
          type: "string",
          description: "Optional classification instructions or guidelines.",
        },
      },
      required: ["text", "labels"],
    },
  },
  {
    name: "jev_relevance",
    description:
      "Evaluate relevance between an objective and candidate items or code snippets using Jev.",
    inputSchema: {
      type: "object",
      properties: {
        objective: {
          type: "string",
          description: "The goal, question, or search target.",
        },
        candidates: {
          type: "array",
          items: {
            type: "object",
            properties: {
              id: { type: "string" },
              text: { type: "string" },
            },
            required: ["id", "text"],
          },
          description: "Candidate excerpts or code snippets to evaluate for relevance.",
        },
      },
      required: ["objective", "candidates"],
    },
  },
];

async function handleMcpToolCall(name, args, token) {
  if (name === "jev_eval") {
    const { state, questions } = args;
    if (!state || !questions) throw new Error("Missing required arguments: state and questions");
    return await runJev(token, { state, questions });
  }

  if (name === "jev_label") {
    const { text, labels, instructions = "Select the most appropriate label." } = args;
    if (!text || !Array.isArray(labels) || labels.length === 0) {
      throw new Error("Missing required arguments: text and labels (non-empty array)");
    }
    const criteria = {};
    for (const label of labels) {
      criteria[label] = `Classify as ${label}`;
    }
    const questions = {
      label: {
        type: "choice",
        instructions,
        criteria,
      },
    };
    return await runJev(token, { state: text, questions });
  }

  if (name === "jev_relevance") {
    const { objective, candidates } = args;
    if (!objective || !Array.isArray(candidates)) {
      throw new Error("Missing required arguments: objective and candidates (array)");
    }
    const results = [];
    for (const candidate of candidates) {
      const state = `Objective: ${objective}\nCandidate [${candidate.id}]:\n${candidate.text}`;
      const questions = {
        is_relevant: {
          type: "noul",
          instructions: "Is this candidate directly relevant and useful for achieving the objective?",
          criteria: { true: "Directly relevant and useful", false: "Not relevant or noise" },
        },
      };
      const res = await runJev(token, { state, questions });
      results.push({
        id: candidate.id,
        decision: res,
      });
    }
    return results;
  }

  throw new Error(`Unknown tool: ${name}`);
}

function startMcpServer() {
  const config = loadConfig();
  if (!config?.api_token) {
    console.error(`[EasyJev] Error: Configuration missing. Please run "${SCRIPT_PATH} --setup" first.`);
    process.exit(1);
  }

  const token = config.api_token;

  function sendResponse(response) {
    process.stdout.write(JSON.stringify(response) + "\n");
  }

  const rl = readline.createInterface({
    input: process.stdin,
    output: process.stdout,
    terminal: false,
  });

  rl.on("line", async (line) => {
    const trimmed = line.trim();
    if (!trimmed) return;

    let request;
    try {
      request = JSON.parse(trimmed);
    } catch (err) {
      sendResponse({
        jsonrpc: "2.0",
        id: null,
        error: { code: -32700, message: "Parse error" },
      });
      return;
    }

    const { id, method, params } = request;

    // Notifications (no id)
    if (id === undefined || id === null) {
      if (method === "notifications/initialized") {
        // Client confirmed initialization; nothing to respond
      }
      return;
    }

    try {
      if (method === "initialize") {
        sendResponse({
          jsonrpc: "2.0",
          id,
          result: {
            protocolVersion: "2024-11-05",
            capabilities: {
              tools: {},
            },
            serverInfo: {
              name: "easyjev",
              version: "0.1.4",
            },
          },
        });
        return;
      }

      if (method === "ping") {
        sendResponse({ jsonrpc: "2.0", id, result: {} });
        return;
      }

      if (method === "tools/list") {
        sendResponse({
          jsonrpc: "2.0",
          id,
          result: {
            tools: MCP_TOOLS,
          },
        });
        return;
      }

      if (method === "tools/call") {
        const { name, arguments: args } = params || {};
        const toolResult = await handleMcpToolCall(name, args, token);
        sendResponse({
          jsonrpc: "2.0",
          id,
          result: {
            content: [
              {
                type: "text",
                text: JSON.stringify(toolResult, null, 2),
              },
            ],
            isError: false,
          },
        });
        return;
      }

      sendResponse({
        jsonrpc: "2.0",
        id,
        error: {
          code: -32601,
          message: `Method not found: ${method}`,
        },
      });
    } catch (err) {
      console.error(`[EasyJev Error] ${method}: ${err.message}`);
      sendResponse({
        jsonrpc: "2.0",
        id,
        result: {
          content: [
            {
              type: "text",
              text: `Error executing ${params?.name || method}: ${err.message}`,
            },
          ],
          isError: true,
        },
      });
    }
  });

  rl.on("close", () => {
    process.exit(0);
  });
}

// ==========================================
// Main Dispatcher
// ==========================================

async function main() {
  const arg = process.argv[2];

  if (arg === "--setup" || arg === "setup") {
    await runSetup();
    return;
  }

  if (arg === "test" || arg === "--test") {
    await runTest();
    return;
  }

  if (arg === "--help" || arg === "-h") {
    console.log("Usage:");
    console.log("  ./easyjev --setup    交互式配置 Cloudflare API Token");
    console.log("  ./easyjev test       测试已保存配置与 Jev 连通性");
    console.log("  ./easyjev            启动 MCP Server (stdio 模式，供 Codex/Antigravity 调用)");
    return;
  }

  // If stdin is not a TTY (spawned by Codex or Antigravity) or explicitly run as MCP
  if (!process.stdin.isTTY || arg === "mcp") {
    startMcpServer();
  } else {
    // Interactive terminal without arguments: show status or prompt setup
    const config = loadConfig();
    if (!config?.api_token) {
      console.log("EasyJev 尚未配置。正在启动配置向导...");
      await runSetup();
    } else {
      console.log("EasyJev 已配置完成并处于就绪状态。");
      console.log(`执行 "./easyjev test" 可测试连通性，或由 Codex / Antigravity 直接以 MCP 模式调起。`);
    }
  }
}

main().catch((err) => {
  console.error("Fatal error:", err.message);
  process.exit(1);
});
