  const config = loadConfig();
  if (!config?.api_token) {
    console.error(`❌ 未找到配置，请先运行: ${process.argv[1]} --setup`);
    process.exit(1);
  }
  console.log("⏳ 正在使用已保存配置请求 Cloudflare Workers AI Jev...");
  try {
    const res = await runJev(config.api_token, {
      state: "Refactor database connection pool to handle up to 50 concurrent queries safely.",
      questions: {
        is_refactor: {
          type: "noul",
          instructions: "Does this involve code refactoring?",
          criteria: { true: "Yes", false: "No" },
        },
        risk_level: {
          type: "choice",
          instructions: "What is the risk level of this task?",
          criteria: {
            low: "Minor stylistic or documentation change",
