#!/usr/bin/env python3
"""
EasyLaya - Single-file CLI & MCP Server for Laya System 1 Decision Engine.
Runs locally, 100% self-hosted, 0 API costs, 0 token consumption.
"""

import os
import sys
import json
import shutil
import platform
import subprocess
from pathlib import Path

VERSION = "0.1.0"

# Directories
HOME_DIR = Path.home()
HIDDEN_INSTALL_DIR = HOME_DIR / ".easylaya"
IS_WINDOWS = platform.system() == "Windows"
BIN_NAME = "easylaya.exe" if IS_WINDOWS else "easylaya"
HIDDEN_BIN_PATH = HIDDEN_INSTALL_DIR / BIN_NAME
CONFIG_PATH = HIDDEN_INSTALL_DIR / "config.json"

# In-memory router instance
_router_instance = None


def get_router(preload: bool = True):
    global _router_instance
    if _router_instance is None:
        try:
            from laya import Router
            _router_instance = Router(preload=preload)
        except ImportError:
            sys.stderr.write(
                "Error: The 'laya' package is not installed in the current Python environment.\n"
                "Please run 'pip install laya' or './easylaya --setup'.\n"
            )
            sys.exit(1)
    return _router_instance


def run_prediction(state, questions, model: str = None):
    router = get_router(preload=True)
    kwargs = {}
    if model:
        kwargs["model"] = model
    return router.predict(state, questions, **kwargs)


# ==========================================
# Config Management
# ==========================================

def load_config():
    if CONFIG_PATH.exists():
        try:
            with open(CONFIG_PATH, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            return {}
    return {}


def make_hidden(path: Path):
    if IS_WINDOWS:
        try:
            import ctypes
            FILE_ATTRIBUTE_HIDDEN = 0x02
            ctypes.windll.kernel32.SetFileAttributesW(str(path), FILE_ATTRIBUTE_HIDDEN)
        except Exception:
            try:
                subprocess.run(
                    ["attrib", "+h", str(path)],
                    check=False,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                )
            except Exception:
                pass


def save_config(data: dict):
    HIDDEN_INSTALL_DIR.mkdir(parents=True, exist_ok=True)
    make_hidden(HIDDEN_INSTALL_DIR)
    with open(CONFIG_PATH, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)
    try:
        os.chmod(CONFIG_PATH, 0o600)
    except Exception:
        pass


# ==========================================
# CLI & Setup Mode
# ==========================================

def run_setup():
    display_dir = "%USERPROFILE%\\.easylaya" if IS_WINDOWS else "~/.easylaya"
    print("\n=========================================")
    print("       EasyLaya 极简自托管配置引导        ")
    print("=========================================\n")
    print("Laya 是完全本地自托管的 System 1 决策引擎（Apache 2.0 协议）。")
    print("无需任何 API Token，零费用，零外发数据，单前向传递 ~33ms 决策。\n")

    # 1. Ensure directory
    HIDDEN_INSTALL_DIR.mkdir(parents=True, exist_ok=True)
    make_hidden(HIDDEN_INSTALL_DIR)

    # 2. Copy binary to hidden dir if needed
    current_script = Path(sys.argv[0]).resolve()
    target_bin = HIDDEN_BIN_PATH

    if current_script != target_bin:
        try:
            shutil.copy2(current_script, target_bin)
            try:
                os.chmod(target_bin, 0o755)
            except Exception:
                pass
            print(f"📦 已自动安装至隐藏目录: {target_bin} ({display_dir})")
            active_bin = str(target_bin)
        except Exception as e:
            print(f"⚠️ 自动安装至 {display_dir} 失败: {e}")
            active_bin = str(current_script)
    else:
        active_bin = str(target_bin)

    # 3. Pre-cache / test model
    print("⏳ 正在初始化并预热 Laya 决策模型（首次运行会自动下载模型权重）...")
    try:
        router = get_router(preload=True)
        res = router.predict(
            "System operational verification.",
            {
                "is_operational": {
                    "type": "noul",
                    "instructions": "Is this system operational?",
                }
            },
        )
        print("✅ 模型加载与预热成功！测试推理完成。")
    except Exception as e:
        print(f"❌ 模型预热失败: {e}")
        sys.exit(1)

    # 4. Save config
    save_config({
        "version": VERSION,
        "default_model": "auto",
    })
    print(f"✅ 配置已写入: {CONFIG_PATH}")

    # 5. Codex CLI integration
    codex_bin = shutil.which("codex")
    if codex_bin:
        print("\n检测到本机已安装 Codex CLI，正在自动注册 MCP Server...")
        try:
            subprocess.run(
                ["codex", "mcp", "add", "easylaya", "--", active_bin],
                check=True,
            )
            print("🎉 已成功自动注册到 Codex！")
        except Exception:
            print("⚠️ 自动注册失败，可手动执行以下命令接入：")
            print(f"   codex mcp add easylaya -- {active_bin}")
    else:
        print("\n💡 接入 Codex CLI 方法：")
        print(f"   codex mcp add easylaya -- {active_bin}")

    # 6. Antigravity integration
    print("\n💡 接入 Antigravity 方法：")
    print("   在 mcp_config.json 的 mcpServers 中添加：")
    escaped_bin = json.dumps(active_bin)
    print(f'   "easylaya": {{ "command": {escaped_bin} }}')

    if current_script != target_bin:
        print(f"\n✨ 提示：当前下载的安装文件现在可以安全删除了，Codex 将永久调用 {display_dir} 目录下的服务。")


def run_test():
    print("⏳ 正在调用本地 Laya 决策模型执行测试推理...")
    try:
        res = run_prediction(
            "Refactor database connection pool to handle up to 50 concurrent queries safely.",
            {
                "is_refactor": {
                    "type": "noul",
                    "instructions": "Does this involve code refactoring?",
                },
                "risk_level": {
                    "type": "choice",
                    "instructions": "What is the risk level of this task?",
                    "criteria": {
                        "low": "Minor stylistic or documentation change",
                        "medium": "Database query or optimization change",
                        "high": "Destructive migration or schema drop",
                    },
                },
            },
        )
        print("✅ 测试成功，Laya 返回结果：")
        print(json.dumps(res, ensure_ascii=False, indent=2))
    except Exception as e:
        print(f"❌ 测试失败: {e}")
        sys.exit(1)


