def handle_mcp_tool_call(name: str, args: dict):
    if name == "laya_eval":
        state = args.get("state")
        questions = args.get("questions")
        model = args.get("model")
        if state is None or not questions:
            raise ValueError("Missing required arguments: state and questions")
        return run_prediction(state, questions, model=model)

    if name == "laya_label":
        text = args.get("text")
        labels = args.get("labels")
        instructions = args.get("instructions", "Select the most appropriate label.")
        model = args.get("model")
        if not text or not isinstance(labels, list) or len(labels) == 0:
            raise ValueError("Missing required arguments: text and labels (non-empty list)")

        criteria = {label: f"Classify as {label}" for label in labels}
        questions = {
            "label": {
                "type": "choice",
                "instructions": instructions,
                "criteria": criteria,
            }
        }
        return run_prediction(text, questions, model=model)

    if name == "laya_relevance":
        objective = args.get("objective")
        candidates = args.get("candidates")
        model = args.get("model")
        if not objective or not isinstance(candidates, list):
            raise ValueError("Missing required arguments: objective and candidates (list)")

        results = []
        for candidate in candidates:
            cand_id = candidate.get("id", "")
            cand_text = candidate.get("text", "")
            state = f"Objective: {objective}\nCandidate [{cand_id}]:\n{cand_text}"
            questions = {
                "is_relevant": {
                    "type": "noul",
                    "instructions": "Is this candidate directly relevant and useful for achieving the objective?",
                    "criteria": {
                        "true": "Directly relevant and useful",
                        "false": "Not relevant or noise",
                    },
                }
            }
            res = run_prediction(state, questions, model=model)
            results.append({
                "id": cand_id,
                "decision": res,
            })
        return results

    raise ValueError(f"Unknown tool: {name}")


def start_mcp_server():
    def send_response(response: dict):
        sys.stdout.write(json.dumps(response, ensure_ascii=False) + "\n")
        sys.stdout.flush()

    for line in sys.stdin:
        trimmed = line.strip()
        if not trimmed:
            continue

        try:
            request = json.loads(trimmed)
        except Exception:
            send_response({
                "jsonrpc": "2.0",
                "id": None,
                "error": {"code": -32700, "message": "Parse error"},
            })
            continue

        req_id = request.get("id")
        method = request.get("method")
        params = request.get("params", {})

        # Notifications (no id)
        if req_id is None:
            if method == "notifications/initialized":
                pass
            continue

        try:
            if method == "initialize":
                send_response({
                    "jsonrpc": "2.0",
                    "id": req_id,
                    "result": {
                        "protocolVersion": "2024-11-05",
                        "capabilities": {
                            "tools": {},
                        },
                        "serverInfo": {
                            "name": "easylaya",
                            "version": VERSION,
                        },
                    },
                })
                continue

            if method == "ping":
                send_response({"jsonrpc": "2.0", "id": req_id, "result": {}})
                continue

            if method == "tools/list":
                send_response({
                    "jsonrpc": "2.0",
                    "id": req_id,
                    "result": {
                        "tools": MCP_TOOLS,
                    },
                })
                continue

            if method == "tools/call":
                tool_name = params.get("name")
                tool_args = params.get("arguments", {})
                tool_result = handle_mcp_tool_call(tool_name, tool_args)
                send_response({
                    "jsonrpc": "2.0",
                    "id": req_id,
                    "result": {
                        "content": [
                            {
                                "type": "text",
                                "text": json.dumps(tool_result, ensure_ascii=False, indent=2),
                            }
                        ],
                        "isError": False,
                    },
                })
                continue

            send_response({
                "jsonrpc": "2.0",
                "id": req_id,
                "error": {
                    "code": -32601,
                    "message": f"Method not found: {method}",
                },
            })
        except Exception as e:
            sys.stderr.write(f"[EasyLaya Error] {method}: {e}\n")
            sys.stderr.flush()
            send_response({
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "content": [
                        {
                            "type": "text",
                            "text": f"Error executing {params.get('name') or method}: {e}",
                        }
                    ],
                    "isError": True,
                },
            })


# ==========================================
# Main Dispatcher
# ==========================================

def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""

    if arg in ("--setup", "setup"):
        run_setup()
        return

    if arg in ("test", "--test"):
        run_test()
        return

    if arg in ("--help", "-h"):
        print("Usage:")
        print("  ./easylaya --setup    初始化配置并安装至 ~/.easylaya/")
        print("  ./easylaya test       测试本地 Laya 模型推理连通性")
        print("  ./easylaya            启动 MCP Server (stdio 模式，供 Codex/Antigravity 调用)")
        return

    # If stdin is not a TTY or explicitly requested as mcp
    if not sys.stdin.isatty() or arg == "mcp":
        start_mcp_server()
    else:
        # Interactive terminal without arguments: show status or prompt setup
        print(f"EasyLaya v{VERSION} - Local System 1 Decision Engine (MCP Server & CLI)")
        print("执行 './easylaya --setup' 可完成初始化安装与 Codex 注册。")
        print("执行 './easylaya test' 可测试本地推理能力。")


if __name__ == "__main__":
    main()
