# HTTP
BASE_URL=https://example.invalid
HTTP_TOKEN=mock-http-token

# RPC authentication is injected only from environment variables.
RPC_ENDPOINT=mock://credit-service
RPC_CLIENT_ID=mock-client
RPC_CLIENT_SECRET=mock-secret

# Database credentials are never stored in JSON/XLSX.
DB_DRIVER=sqlite
DB_PATH=:memory:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=example
DB_USER=mock-user
DB_PASSWORD=mock-password

# Required only when writing or replacing snapshot baselines.
CONFIRM_BASELINE=0
