{
  "profiles": {
    "default": {
      "database_rows": {
        "kind": "database",
        "select": "$.rows",
        "unordered_lists": [
          {
            "keys": [
              "id"
            ],
            "path": "$"
          }
        ]
      },
      "response_default": {
        "ignore_paths": [
          "$.attempts",
          "$.elapsed_ms",
          "$.url"
        ],
        "kind": "response",
        "select": "$"
      },
      "screenshot_default": {
        "artifact": "screenshot",
        "kind": "screenshot"
      }
    }
  }
}
